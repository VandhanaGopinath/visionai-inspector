#GEMINI_API_KEY=paste-your-key-here
# GEMINI_MODEL=gemini-flash-latest

# Local LLM option (no key, no quota): install Ollama, then `ollama pull llama3.2:3b`
LLM_PROVIDER=auto        # auto (Gemini if key set, else Ollama) | gemini | ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
